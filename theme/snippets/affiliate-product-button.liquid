{%- comment -%}
  Renders the external affiliate "Shop Now" style button for Mavely affiliate products.
  Paste into main-product.liquid in place of the add-to-cart / buy-it-now buttons,
  wrapped in the affiliate_product check as shown in theme/README.md.

  Only renders when product.metafields.custom.mavely_link is present.
{%- endcomment -%}

{%- assign mavely_link = product.metafields.custom.mavely_link.value -%}
{%- if mavely_link != blank -%}
  <a
    href="{{ mavely_link }}"
    class="button button--primary affiliate-product-button"
    target="_blank"
    rel="sponsored nofollow noopener"
  >
    {{ product.metafields.custom.external_button_label.value | default: 'Shop Now' }}
  </a>
{%- endif -%}
