# Optional: enables live AI generation. Without it, the app uses a strong built-in generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: saves products to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables one-click draft publishing to Shopify.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Required for the Mavely Affiliate Product Importer:
# Shared password gate for the whole app (middleware.ts). Pick a strong shared secret.
APP_PASSWORD=

# The Mavely feature requires Supabase and Shopify to be fully configured above
# (NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SHOPIFY_STORE_DOMAIN,
# SHOPIFY_ADMIN_ACCESS_TOKEN) — it will return clear errors from the API routes if
# any of these are missing rather than failing silently.

# FCP Ad Studio (Phase 1) reuses NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SHOPIFY_STORE_DOMAIN, SHOPIFY_ADMIN_ACCESS_TOKEN, and SHOPIFY_API_VERSION above —
# no new required env vars beyond what Mavely already needs. See docs/ad-studio.md
# for the Supabase Storage "ad-studio" bucket setup (created via dashboard/CLI, not env vars).

# Reserved for Phase 2 — NOT implemented yet (no code in this repo calls Runway).
# Do not set this expecting it to do anything in Phase 1.
RUNWAY_API_KEY=
